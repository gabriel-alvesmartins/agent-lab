# ========================================================
# 🔑 AGENT LAB — CHAVES DE API DOS PROVEDORES DE LLM
# ========================================================

# 1. Anthropic Claude (Modelo oficial e padrão da plataforma AI-4SDLC)
# Suporta: claude-sonnet-5-5, claude-haiku-5-5, claude-opus-5-5
ANTHROPIC_API_KEY=sk-ant-api03-...
# Caso use uma chave de usuário (sk-ant-usr-...), informe o Workspace ID (wrkspc_...) abaixo:
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# 2. OpenAI
# Suporta: gpt-6-astra, gpt-6-1-sol, gpt-6-luna
OPENAI_API_KEY=sk-proj-...

# 3. Google Gemini
# Suporta: gemini-4-argon, gemini-3-8-flash, gemini-3-8-live-extended-thinking, gemini-3-8-live
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...

# 4. Ollama Local (Opcional, modelo local sem custo)
# Suporta: llama3.3, qwen2.5-coder, deepseek-r1
# OLLAMA_BASE_URL=http://localhost:11434
